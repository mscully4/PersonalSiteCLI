# ---------------------------------------------------------------------------
# Personal Site CLI -- local configuration
# This file holds secrets and is ignored by git. Never commit it.
# ---------------------------------------------------------------------------

# --- Immich -------------------------------------------------------------
# Base URL of your Immich server, INCLUDING the /api suffix (the client
# normalizes a missing suffix, but be explicit).
#   e.g. http://immich.lan:2283/api  or  https://photos.example.com/api
IMMICH_BASE_URL=http://immich.lan:2283/api

# Immich API key: Immich web UI -> Account Settings -> API Keys -> New API Key.
# Required permissions: album.read, asset.read
IMMICH_API_KEY=

# --- Google Maps --------------------------------------------------------
# Places Autocomplete + Geocoding. Google Cloud Console -> Credentials.
GOOGLE_MAPS_API_KEY=

# --- AWS ----------------------------------------------------------------
# AWS profile from ~/.aws/credentials to use. Set this explicitly -- it
# insulates the CLI from a stale AWS_PROFILE exported in your shell.
AWS_PROFILE=default

AWS_REGION_NAME=us-east-1
# S3 bucket holding the site's images and thumbnails
AWS_PHOTOS_BUCKET=
# Suffix Amplify appends to each model's table name, e.g.
# TravelPhoto<suffix>.  From the Amplify console or `aws dynamodb list-tables`
AMPLIFY_TABLE_SUFFIX=
# CloudFront domain the site serves images through
IMAGE_BASE_URL=

# DynamoDB single table the site reads from
AWS_TABLE_NAME=

# Optional: only needed if you are NOT using ~/.aws/credentials or an
# instance role. Leave blank to let boto3 use its default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
